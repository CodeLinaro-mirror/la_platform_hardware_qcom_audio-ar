<module name="stub" halVersion="2.0">
    <attachedDevices>
        <item>Default Out</item>
        <item>Default In</item>
        <item>Media Bus</item>
        <item>Primary In Bus</item>
        <item>Sys Notification Bus</item>
        <item>Nav Guidance Bus</item>
        <item>Phone Bus</item>
        <item>Alerts Bus</item>
        <item>Phone Bus</item>
        <item>builtin_mic</item>
        <item>Front Passenger Bus</item>
        <item>Rear Seat Bus</item>

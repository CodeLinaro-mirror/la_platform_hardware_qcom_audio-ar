        <route type="mix" sink="Front Passenger Bus" sources="usage_front_output"/>
        <route type="mix" sink="Rear Seat Bus" sources="usage_rear_output"/>
        <route type="mix" sink="usage_voice_input_front_bus" sources="Front In Bus"/>
        <route type="mix" sink="usage_voice_input_rear_bus" sources="Rear In Bus"/>

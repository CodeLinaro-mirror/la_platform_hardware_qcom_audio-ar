        <gain name="" mode="AUDIO_GAIN_MODE_JOINT" minValueMB="-6000" maxValueMB="600" defaultValueMB="0" stepValueMB="100"/>
            </gains>
        </devicePort>
        <devicePort tagName="Rear Seat Bus" role="sink" type="AUDIO_DEVICE_OUT_BUS" address="BUS16_REAR_SEAT">
    <profile name="" format="AUDIO_FORMAT_PCM_16_BIT" samplingRates="48000" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
            <gains>
        <gain name="" mode="AUDIO_GAIN_MODE_JOINT" minValueMB="-6000" maxValueMB="600" defaultValueMB="0" stepValueMB="100"/>
            </gains>
        </devicePort>
        <devicePort tagName="Front In Bus" type="AUDIO_DEVICE_IN_BUS" role="source" address="BUS09_INPUT_FRONT_PASSENGER">
        <profile name="" format="AUDIO_FORMAT_PCM_16_BIT" samplingRates="48000" channelMasks="AUDIO_CHANNEL_IN_STEREO"/>
            <gains>
            <gain name="" mode="AUDIO_GAIN_MODE_JOINT" minValueMB="-6000" maxValueMB="600" defaultValueMB="0" stepValueMB="100"/>
            </gains>
        </devicePort>
        <devicePort tagName="Rear In Bus" type="AUDIO_DEVICE_IN_BUS" role="source" address="BUS17_INPUT_REAR_SEAT">

aidl_interface {
    name: "qti-audio-types-aidl",
    stability: "vintf",
    owner: "qcom",
    vendor: true,
    local_include_dir: "aidl",
    srcs: [
        "aidl/qti/audio/core/VString.aidl",
    ],
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },

    ],
    frozen: true,
}

cc_library {
    name: "libaudiohalvendorextn",
    vendor: true,
    srcs: ["HalAdapterVendorExtension.cpp"],

    export_include_dirs: [
        "include",
    ],

    header_libs: [
        "libsystem_headers",
    ],

    shared_libs: [
        "av-audio-types-aidl-ndk",
        "libbinder_ndk",
        "libbase",
        "qti-audio-types-aidl-V1-ndk",
        "libutils",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wthread-safety",
        "-DBACKEND_NDK",
    ],
}
